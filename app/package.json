{
  "name": "urafess-app",
  "private": true,
  "version": "0.1.0",
  "description": "Urafess のアプリの土台：入室・①配役（鬼3：逃走者7）・②同期タイマー",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "sim": "vitest run --config vitest.sim.config.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "ggwave": "^0.4.0"
  }
}
