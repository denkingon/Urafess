import express from 'express'
import http from 'http'
import { Server } from 'socket.io'
import cors from 'cors'

const app = express()
app.use(cors())

const server = http.createServer(app)
const io = new Server(server, {
  cors: {
    origin: '*',
    methods: ['GET', 'POST']
  }
})

const users = new Map()

io.on('connection', socket => {
  users.set(socket.id, { latitude: 0, longitude: 0, text: '' })
  socket.emit('users', Object.fromEntries(users))
  socket.broadcast.emit('userUpdate', { id: socket.id, data: users.get(socket.id) })

  socket.on('location', data => {
    const user = users.get(socket.id) || {}
    users.set(socket.id, { ...user, ...data })
    io.emit('userUpdate', { id: socket.id, data: users.get(socket.id) })
  })

  socket.on('message', ({ text }) => {
    const user = users.get(socket.id) || {}
    users.set(socket.id, { ...user, text })
    io.emit('userUpdate', { id: socket.id, data: users.get(socket.id) })
  })

  socket.on('disconnect', () => {
    users.delete(socket.id)
    io.emit('userDisconnect', socket.id)
  })
})

const PORT = process.env.PORT || 3000
server.listen(PORT, () => console.log(`Server listening on ${PORT}`))
