import { useEffect, useState, useRef } from 'react'
import { MapContainer, TileLayer, CircleMarker, Popup } from 'react-leaflet'
import 'leaflet/dist/leaflet.css'
import io from 'socket.io-client'

const socket = io('http://localhost:3000') // change if server runs elsewhere

export default function App () {
  const [users, setUsers] = useState({})
  const [myId, setMyId] = useState(null)
  const mapRef = useRef()

  const updateUsers = (id, data) =>
    setUsers(prev => ({ ...prev, [id]: { ...prev[id], ...data } }))

  // Geolocation tracking
  useEffect(() => {
    if (!('geolocation' in navigator)) {
      alert('Geolocation not supported. App cannot run.')
      return
    }

    const watchId = navigator.geolocation.watchPosition(
      pos => {
        const { latitude, longitude } = pos.coords
        socket.emit('location', { latitude, longitude })
      },
      err => console.error(err),
      { enableHighAccuracy: true, maximumAge: 1000 }
    )

    return () => navigator.geolocation.clearWatch(watchId)
  }, [])

  // Socket.IO events
  useEffect(() => {
    socket.on('connect', () => setMyId(socket.id))

    socket.on('users', all => setUsers(all))

    socket.on('userUpdate', ({ id, data }) => updateUsers(id, data))

    socket.on('userDisconnect', id => {
      setUsers(prev => {
        const { [id]: _, ...rest } = prev
        return rest
      })
    })

    return () => socket.off()
  }, [])

  // Speech‑to‑text
  useEffect(() => {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition
    if (!SpeechRecognition) return

    const recognizer = new SpeechRecognition()
    recognizer.lang = 'ja-JP'
    recognizer.continuous = true
    recognizer.interimResults = false

    recognizer.onresult = e => {
      const transcript = Array.from(e.results)
        .map(r => r[0].transcript)
        .join('')
        .trim()
      if (transcript) {
        socket.emit('message', { text: transcript })
        updateUsers(myId, { text: transcript })
      }
    }

    recognizer.onerror = console.error
    recognizer.start()

    return () => recognizer.stop()
  }, [myId])

  // Map default center
  const position = [35.681236, 139.767125]

  return (
    <MapContainer
      center={position}
      zoom={12}
      scrollWheelZoom
      whenCreated={map => (mapRef.current = map)}
      className="h-full w-full"
    >
      <TileLayer
        attribution="&copy; OpenStreetMap"
        url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      />
      {Object.entries(users).map(([id, user]) => (
        <CircleMarker
          key={id}
          center={[user.latitude, user.longitude]}
          radius={10}
          pathOptions={{ color: '#ff0000' }}
        >
          {user.text && (
            <Popup>
              <span className="whitespace-pre-line">{user.text}</span>
            </Popup>
          )}
        </CircleMarker>
      ))}
    </MapContainer>
  )
}

